+        public static unsafe bool TryGetVmBreakdown(out ulong resident, out ulong device, out ulong internalBytes, out ulong externalBytes, out ulong compressed)
+        {
+            resident = device = internalBytes = externalBytes = compressed = 0;
+
+            if (!OperatingSystem.IsMacOS() && !OperatingSystem.IsIOS())
+            {
+                return false;
+            }
+
+            try
