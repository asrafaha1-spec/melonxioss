@@ -0,0 +1,45 @@
+using System.Diagnostics;
+using System.Text;
+
+namespace Ryujinx.Common.Logging
+{
+    /// <summary>
+    /// Logs big managed allocations with where they came from, to find what makes the managed heap jump.
+    /// </summary>
+    public static class LargeAllocationLog
+    {
+        private const long ThresholdBytes = 32L * 1024 * 1024;
+
+        public static void Report(string site, long bytes)
+        {
+            if (bytes < ThresholdBytes)
+            {
+                return;
+            }
+
+            StringBuilder frames = new();
+
+            try
+            {
+                StackTrace trace = new(1, false);
+                int count = trace.FrameCount < 7 ? trace.FrameCount : 7;
+
+                for (int i = 0; i < count; i++)
+                {
+                    System.Reflection.MethodBase method = trace.GetFrame(i)?.GetMethod();
+
+                    if (method != null)
+                    {
+                        frames.Append(" <- ").Append(method.DeclaringType?.Name).Append('.').Append(method.Name);
+                    }
+                }
+            }
+            catch
+            {
+                // Stack traces are best effort.
+            }
+
+            Logger.Info?.Print(LogClass.Gpu, $"Large allocation: {site} {bytes / 1024.0 / 1024.0:0.0} MiB{frames}");
+        }
+    }
+}
