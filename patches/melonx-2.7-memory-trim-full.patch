+        /// <summary>
+        /// Reads the task_vm_info breakdown of this process, in bytes. Returns false if unavailable.
+        /// </summary>
+        public static unsafe bool TryGetVmBreakdown(out ulong resident, out ulong device, out ulong internalBytes, out ulong externalBytes, out ulong compressed)
+        {
+            resident = device = internalBytes = externalBytes = compressed = 0;
+
+            if (!OperatingSystem.IsMacOS() && !OperatingSystem.IsIOS())
+            {
+                return false;
+            }
+
+            try
+            {
+                ulong* info = stackalloc ulong[(int)(TaskVmInfoCount / 2 + 1)];
+                uint count = TaskVmInfoCount;
+
+                if (TaskInfo(MachTaskSelf(), TaskVmInfo, info, &count) != 0)
+                {
+                    return false;
+                }
+
+                resident = info[16 / 8];
+                device = info[32 / 8];
+                internalBytes = info[48 / 8];
+                externalBytes = info[64 / 8];
+                compressed = info[120 / 8];
+
+                return true;
+            }
+            catch (EntryPointNotFoundException)
+            {
+                return false;
+            }
+        }
