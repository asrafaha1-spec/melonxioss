@@ -55,6 +55,19 @@
         internal Lock QueueLock { get; private set; }
         internal Lock PipelineCreationLock { get; private set; }
 
+        private static VulkanRenderer _activeRenderer;
+
+        /// <summary>
+        /// Writes the current pipeline cache to disk, if a renderer is running. Safe to call from any thread and
+        /// never throws. Intended for when emulation is paused or the app moves to the background.
+        /// </summary>
+        public static void CheckpointPipelineCache()
+        {
+            VulkanRenderer renderer = Volatile.Read(ref _activeRenderer);
+
+            renderer?.PipelineCacheManager?.Checkpoint();
+        }
+
         internal MemoryAllocator MemoryAllocator { get; private set; }
         internal HostMemoryAllocator HostMemoryAllocator { get; private set; }
         internal DonatedBufferAllocator DonatedBufferAllocator { get; private set; }
@@ -565,6 +578,7 @@
                 BackgroundCompilationScheduler.PipelineCacheCount,
                 PipelineCreationLock);
             BackgroundCompilationScheduler = new(PipelineCacheManager);
+            Volatile.Write(ref _activeRenderer, this);
 
             LoadFeatures(maxQueueCount, queueFamilyIndex);
 
@@ -1136,6 +1150,11 @@
 
             Api.DeviceWaitIdle(_device);
 
+            if (ReferenceEquals(Volatile.Read(ref _activeRenderer), this))
+            {
+                Volatile.Write(ref _activeRenderer, null);
+            }
+
             PipelineCacheManager.MergeAndSave();
 
             CommandBufferPool.Dispose();
diff -ruN a/src/Ryujinx.Library/Library.cs b/src/Ryujinx.Library/Library.cs
--- a/src/Ryujinx.Library/Library.cs	2026-10-30 20:20:26.932824789 +0000
+++ b/src/Ryujinx.Library/Library.cs	2026-10-30 20:20:38.804443201 +0000
@@ -203,6 +203,13 @@
             if (_emulationContext != null && _emulationContext.System != null)
             {
                 _emulationContext.System.TogglePauseEmulation(shouldPause);
+
+                if (shouldPause)
+                {
+                    // The app may be about to be backgrounded and then killed, which skips the normal shutdown
+                    // save of the pipeline cache. Do it off the caller's thread; it never throws.
+                    ThreadPool.QueueUserWorkItem(static _ => VulkanRenderer.CheckpointPipelineCache());
+                }
             }
         }
 
