diff -ruN a/src/Ryujinx.Graphics.Vulkan/PipelineCacheManager.cs b/src/Ryujinx.Graphics.Vulkan/PipelineCacheManager.cs
--- a/src/Ryujinx.Graphics.Vulkan/PipelineCacheManager.cs	2026-10-30 20:20:26.931381377 +0000
+++ b/src/Ryujinx.Graphics.Vulkan/PipelineCacheManager.cs	2026-10-30 20:20:38.803076689 +0000
@@ -268,7 +268,44 @@
                 Logger.Warning?.PrintMsg(
                     LogClass.Gpu,
                     $"The Vulkan main pipeline cache has passed its {FormatSize(_mainState.Budget)} budget " +
-                    $"(estimated {FormatSize(_mainState.EstimatedBytes)}); it will not be persisted until it fits.");
+                    $"(estimated at {FormatSize(_mainState.EstimatedBytes)} from a per-pipeline placeholder; the real size is " +
+                    $"measured when the cache is saved, and it is only skipped then if it really is over budget).");
+            }
+        }
+
+        /// <summary>
+        /// Saves the main pipeline cache to disk without disposing anything, so the work done by this session
+        /// survives the app being killed while in the background (iOS gives no reliable shutdown hook).
+        /// <para/>
+        /// The main cache is otherwise only written by <see cref="MergeAndSave"/> when the renderer is disposed.
+        /// This holds the pipeline creation lock for the duration of the write, so it must only be called when a
+        /// stall does not matter, such as when emulation has just been paused. Worker caches are not touched: they
+        /// are used by their own threads and already checkpoint themselves from there.
+        /// </summary>
+        public void Checkpoint()
+        {
+            if (_disposed)
+            {
+                return;
+            }
+
+            try
+            {
+                lock (_mainCacheLock)
+                {
+                    if (_disposed || _mainState.PipelineCount == _mainState.SavedPipelineCount)
+                    {
+                        // Nothing was created since the last save.
+                        return;
+                    }
+
+                    Maintain(_mainState, force: true, allowRecycle: false);
+                }
+            }
+            catch (Exception exception)
+            {
+                // Called from the native pause path, where an exception would take the whole app down.
+                Logger.Warning?.PrintMsg(LogClass.Gpu, $"Vulkan pipeline cache checkpoint failed: {exception.Message}");
             }
         }
 
diff -ruN a/src/Ryujinx.Graphics.Vulkan/VulkanRenderer.cs b/src/Ryujinx.Graphics.Vulkan/VulkanRenderer.cs
